# Send only source needed by the monorepo web build. This excludes the host
# checkout, environment files, research material and captured verification
# images from the Docker build context by default.
**
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!LICENSE
!NOTICE
!tsconfig.json
!tsconfig.base.json
!apps
!apps/**
!packages
!packages/**
!fixtures
!fixtures/**
!scripts
!scripts/**
!docs
docs/**
!docs/assets
docs/assets/**
!docs/assets/hasi-hero-light.svg
!docs/assets/hasi-hero-dark.svg

# Re-exclude local credentials, generated files, caches and non-build data even
# beneath the directories re-included above.
**/.env*
**/.git
**/.vercel
**/node_modules
**/.next
**/dist
**/coverage
**/.turbo
**/.cache
**/.pnpm-store
**/research
**/verification
**/captures
**/*token*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.log
**/*.test.*
**/*.spec.*
**/tests
