# Browser simulation for anny/session/admin data; model calls use the server.
# Set this only when building/running the public demonstration UI.
NEXT_PUBLIC_HASI_PUBLIC_DEMO=0

# Local full-stack UI proxy, unused in public browser-demo mode.
HASI_API_ORIGIN=http://127.0.0.1:4100
HASI_WEB_PORT=3001

# The Next.js server loads apps/web/.env.local, not this root template.
# Configure GROQ_API_KEY there or inject it into the server process environment.
# Production/Preview use a Vercel Secret. Never use NEXT_PUBLIC_ for credentials.
