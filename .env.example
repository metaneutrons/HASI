# Template only. Next.js loads apps/web/.env.local; the root pnpm dev launcher
# continues to run its separate-process, in-memory backend.

# Public demo UI build flag and server runtime switch.
NEXT_PUBLIC_HASI_PUBLIC_DEMO=0
HASI_DEMO_MODE=0

# For local server-backed demo mode, set these in apps/web/.env.local and use
# a local PostgreSQL database plus a freshly generated 32-byte base64url secret.
HASI_DEMO_ORIGIN=http://127.0.0.1:3001
DATABASE_URL=
HASI_DEMO_SECRET=

# Model calls resolve this credential on the server only.
GROQ_API_KEY=
GWDG_API_KEY=

# Optional OpenAI-compatible profile. The endpoint and model ID are server-only.
CUSTOM_API_KEY=
CUSTOM_ENDPOINT=
CUSTOM_MODEL_ID=

# Separate-process local reference stack settings.
HASI_API_ORIGIN=http://127.0.0.1:4100
HASI_WEB_PORT=3001

# Optional v1 operator model registry. JSON contents, NOT a path. Omit this
# variable entirely to use the bundled Groq/GWDG + legacy Custom settings.
# An empty/invalid explicit value fails closed. Never put secret values in JSON.
# HASI_LLM_CONFIG={"schemaVersion":1,...}
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Additional connections can resolve env:HASI_LLM_SECRET_<NAME>.
# HASI_LLM_SECRET_CAMPUS_A=
