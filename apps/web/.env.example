# Next.js loads apps/web/.env.local when invoked through pnpm --filter @hasi/web.
# Copy this template locally; never commit the populated .env.local file.
# Provider credentials stay server-side and must never use a NEXT_PUBLIC_ prefix.
GROQ_API_KEY=
GWDG_API_KEY=
DEEPINFRA_API_KEY=
CUSTOM_API_KEY=
CUSTOM_ENDPOINT=
CUSTOM_MODEL_ID=
NEXT_PUBLIC_HASI_PUBLIC_DEMO=0
HASI_API_ORIGIN=http://127.0.0.1:4100

# Optional v1 operator model registry. JSON contents, NOT a path. Omit this
# variable entirely to use the bundled Groq/GWDG/DeepInfra + legacy Custom settings.
# An empty/invalid explicit value fails closed. Never put secret values in JSON.
# HASI_LLM_CONFIG={"schemaVersion":1,...}
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Additional connections can resolve env:HASI_LLM_SECRET_<NAME>.
# HASI_LLM_SECRET_CAMPUS_A=
