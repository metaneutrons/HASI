{
  "name": "@hasi/web",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-only",
  "author": "Fabian Schmieder",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metaneutrons/HASI.git",
    "directory": "apps/web"
  },
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port ${PORT:-3001}",
    "build": "pnpm --filter @hasi/demo-runtime... run build && node --conditions=react-server --import tsx scripts/initialize-model-budget.ts --if-enabled && next build",
    "start": "next start --hostname 127.0.0.1 --port ${PORT:-3001}",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.81",
    "@ai-sdk/groq": "4.0.62",
    "@ai-sdk/openai": "4.0.95",
    "@ai-sdk/openai-compatible": "3.0.70",
    "@hasi/demo-fixtures": "workspace:*",
    "@hasi/demo-runtime": "workspace:*",
    "@hasi/knowledge-plugin": "workspace:*",
    "@hasi/plugin-sdk": "workspace:*",
    "@hasi/state": "workspace:*",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@vercel/firewall": "1.2.6",
    "ai": "7.0.142",
    "lucide-react": "1.58.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2"
  },
  "type": "module"
}
