{
  "schemaVersion": 1,
  "connections": [
    {
      "id": "groq-demo",
      "label": "GroqCloud demo",
      "provider": "groq",
      "credentialRef": "env:GROQ_API_KEY"
    },
    {
      "id": "gwdg-demo",
      "label": "GWDG SAIA demo",
      "provider": "gwdg",
      "credentialRef": "env:GWDG_API_KEY"
