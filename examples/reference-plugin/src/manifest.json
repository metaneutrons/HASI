{
  "manifestVersion": 2,
  "apiVersion": "2.0.0",
  "mcpVersion": "2026-07-28",
  "id": "hasi.reference",
  "name": "HASI Reference Plugin",
  "description": "A local-only generic v2 plugin for lifecycle qualification.",
  "version": "1.0.0",
  "configuration": {
    "schema": {
      "type": "object",
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 80 }
      },
      "required": ["label"],
      "additionalProperties": false
    },
    "fields": [{ "name": "label", "label": "Public label", "help": "Local synthetic target for the reference plugin." }]
  },
  "identity": { "claims": ["reference.account"] },
  "tools": [
    {
      "name": "read_status",
      "title": "Read status",
      "description": "Returns the configured public label and scoped account claim.",
      "effect": "read",
      "requiredPermissions": ["reference:read"],
      "inputSchema": { "type": "object", "properties": {}, "additionalProperties": false },
      "outputSchema": {
        "type": "object",
        "properties": {
          "label": { "type": "string" },
          "account": { "type": "string" },
          "version": { "type": "string" },
          "actionCount": { "type": "integer", "minimum": 0 }
        },
        "required": ["label", "account", "version", "actionCount"],
        "additionalProperties": false
      },
      "visibility": ["model"]
    },
    {
      "name": "prepare_mark",
      "title": "Prepare mark",
      "description": "Prepares a synthetic confirmed action for the configured public label.",
      "effect": "prepare",
      "requiredPermissions": ["reference:prepare"],
      "inputSchema": { "type": "object", "properties": {}, "additionalProperties": false },
      "outputSchema": {
        "type": "object",
        "properties": {
          "draft": {
            "type": "object",
            "properties": {
              "executionTool": { "type": "string" },
              "arguments": {
                "type": "object",
                "properties": { "label": { "type": "string" } },
                "required": ["label"],
                "additionalProperties": false
              },
              "resourceName": { "type": "string" }
            },
            "required": ["executionTool", "arguments", "resourceName"],
            "additionalProperties": false
          }
        },
        "required": ["draft"],
        "additionalProperties": false
      },
      "visibility": ["model"]
    },
    {
      "name": "execute_mark",
      "title": "Execute mark",
      "description": "Increments a durable installation- and account-scoped synthetic confirmation counter.",
      "effect": "execute",
      "requiredPermissions": ["reference:execute"],
      "inputSchema": {
        "type": "object",
        "properties": { "label": { "type": "string", "minLength": 1, "maxLength": 80 } },
        "required": ["label"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "confirmed": { "type": "boolean" },
          "actionCount": { "type": "integer", "minimum": 1 },
          "label": { "type": "string" },
          "account": { "type": "string" }
        },
        "required": ["confirmed", "actionCount", "label", "account"],
        "additionalProperties": false
      },
      "visibility": ["model"]
    }
  ]
}
